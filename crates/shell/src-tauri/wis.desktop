# Custom desktop-entry template for the Linux bundles (deb + AppImage reuse
# it): the stock tauri template carries no MimeType and no %U field code, so
# Wis would neither appear in default-browser pickers nor receive the clicked
# URL. Variables are filled by tauri-bundler's freedesktop generator.
[Desktop Entry]
Categories=Network;WebBrowser;
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %U
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
