<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shown in the system biometric sheet when unlocking the password vault.
       Required for Face ID; also used as a courtesy on Touch ID Macs. -->
  <key>NSFaceIDUsageDescription</key>
  <string>Wis uses Touch ID to unlock your saved passwords.</string>

  <!-- Required so the embedded WebKit view can use the camera/microphone for
       sites you allow (video calls, voice). Without these the OS terminates
       the app on first capture. Per-site consent is enforced in-app before the
       device is ever opened. -->
  <key>NSCameraUsageDescription</key>
  <string>Allow sites you approve to use your camera, for example for video calls.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Allow sites you approve to use your microphone, for example for voice and video calls, and let you speak prompts to the canvas agent.</string>
  <!-- Spoken canvas prompts run Apple's speech recognition on device only. -->
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Turn what you say into canvas agent prompts, on this Mac only.</string>

  <!-- Registers Wis as an http(s) handler with Launch Services: required to
       appear in System Settings' default-browser picker and to receive links
       from other apps (delivered as Apple Events -> RunEvent::Opened). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Web URLs</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>http</string>
        <string>https</string>
      </array>
    </dict>
  </array>

  <!-- Declares Wis a viewer of HTML documents; macOS expects a default
       browser to claim the content types as well as the URL schemes. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>HTML document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.html</string>
        <string>public.xhtml</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
