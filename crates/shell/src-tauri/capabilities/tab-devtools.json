{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tab-devtools",
  "description": "Allow toggling devtools from inside tab webviews (e.g. via Cmd+Opt+I on remote pages).",
  "windows": [
    "main"
  ],
  "webviews": [
    "tab-*"
  ],
  "remote": {
    "urls": [
      "http://**",
      "https://**"
    ]
  },
  "permissions": [
    "core:webview:allow-internal-toggle-devtools"
  ]
}
